# Force binary handling for asset types that must never go through
# line-ending conversion, regardless of core.autocrlf on a contributor's
# machine. Prevents corruption risk on Windows checkouts.
*.pdf   binary
*.pptx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.safetensors binary
*.bin   binary
*.pt    binary
*.faiss binary
*.wav   binary
*.mp3   binary
